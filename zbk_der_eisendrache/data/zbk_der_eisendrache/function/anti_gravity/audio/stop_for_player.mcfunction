# Prevent room audio from following a player beyond the anti-gravity boundary.
stopsound @s player zbk_der_eisendrache:der_eisendrache.anti_gravity.room.anti_gravity_start
stopsound @s player zbk_der_eisendrache:der_eisendrache.anti_gravity.room.anti_gravity_loop
stopsound @s player zbk_der_eisendrache:der_eisendrache.anti_gravity.room.anti_gravity_stop
