# Deal 5 damage per pulse; constant player Saturation can regenerate about 1 health
# between pulses, leaving the intended net drain near 4 health every 10 ticks.
damage @s 5 minecraft:generic
particle minecraft:flame ~ ~1.0 ~ 0.30 0.45 0.30 0.03 4 force
particle minecraft:smoke ~ ~1.1 ~ 0.20 0.30 0.20 0.01 2 force
