{
  "type": "minecraft:multi_action",
  "title": "Custom Start",
  "external_title": "Custom Start",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Pick the round to start on for testing."
    }
  ],
  "inputs": [
    {
      "type": "number_range",
      "key": "round",
      "label": "Start Round",
      "start": 1,
      "end": 999,
      "initial": 1,
      "step": 1
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Start With Cutscene",
        "color": "green"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "function zbk:game/management/custom_start/with_cutscene {round:$(round)}"
      }
    },
    {
      "label": {
        "text": "Start No Cutscene",
        "color": "green"
      },
      "action": {
        "type": "dynamic/run_command",
        "template": "function zbk:game/management/custom_start/no_cutscene {round:$(round)}"
      }
    },
    {
      "label": {
        "text": "Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:zombies"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
