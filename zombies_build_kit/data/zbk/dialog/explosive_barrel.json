{
  "type": "minecraft:multi_action",
  "title": "Explosive Barrel",
  "external_title": "Explosive Barrel",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Setup Guide:\n1. Get explosive barrel spawn egg\n2. Place barrels where players can shoot them\n3. Reset all barrels after edits or testing"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Explosive Barrel - Spawn Egg",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_explosive_barrel_egg set 1"
      }
    },
    {
      "label": {
        "text": "Reset All Barrels",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "/function zbk:build_kit/management/explosive_barrel/reset_all_barrels"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:map_elements"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
