{
  "type": "minecraft:multi_action",
  "title": "Custom Doors",
  "external_title": "Custom Doors",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Get placement frames for custom door markers\n\nCorners define the block region. Signs are the purchase point.\nPlace Corner 1 and Corner 2, then assign matching IDs with the Build Stick."
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Get All Frames",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_custom_door_egg set 1"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:build_kit/map_elements/doors/doors"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
