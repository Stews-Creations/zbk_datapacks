{
  "type": "minecraft:multi_action",
  "title": "Purchasable Doors",
  "external_title": "Purchasable Doors",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Get placement frames for purchasable doors that players can buy with points"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Door Marker Frame",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_door_egg set 1"
      }
    },
    {
      "label": {
        "text": "Gate Door Marker Frame",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_gate_door_egg set 1"
      }
    },
    {
      "label": {
        "text": "Jump Spot Marker Frame",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_jump_spot_egg set 1"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:build_kit/map_elements/doors/doors"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
