{
  "type": "minecraft:multi_action",
  "title": "Traps",
  "external_title": "Traps",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Setup Guide:\n1. Get trap frames\n2. Place 2 corner frames and 1 sign frame\n3. Frames convert to trap markers automatically\n4. Use Build Stick to set options"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Electric Trap - Marker Frame",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_electric_trap_egg set 1"
      }
    },
    {
      "label": {
        "text": "Reset All Traps",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "trigger reset_traps set 1"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:build_kit/map_elements"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
