{
  "type": "minecraft:multi_action",
  "title": "Wall Buy - Launchers",
  "external_title": "Launchers",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Select a weapon to set this wall buy."
    }
  ],
  "actions": [
    {
      "label": {
        "text": "XM-53",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zbk:map_elements/wall_gun/build_kit/settings/apply_gun_id {gun_id:46}"
      }
    },
    {
      "label": {
        "text": "Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:build_kit/map_elements/wall_gun/weapons"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
