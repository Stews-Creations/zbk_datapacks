{
  "type": "minecraft:multi_action",
  "title": "Buildables",
  "external_title": "Buildables",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Crafting benches and buildable equipment. Place any number of benches; shield part eggs place candidate spawn locations."
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Crafting Bench Spawn Egg",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger buildables_action set 1"
      }
    },
    {
      "label": {
        "text": "Shield ->",
        "color": "gold"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:build_kit/buildables/shield"
      }
    },
    {
      "label": {
        "text": "<- Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:build_kit"
      }
    }
  ],
  "exit_action": {
    "label": "Close"
  },
  "columns": 2,
  "pause": false
}
