{
  "type": "minecraft:multi_action",
  "title": "Quick Actions",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Quick access to game controls and stats."
    }
  ],
  "columns": 1,
  "actions": [
    {
      "label": {
        "text": "Combat Record",
        "color": "aqua"
      },
      "action": {
