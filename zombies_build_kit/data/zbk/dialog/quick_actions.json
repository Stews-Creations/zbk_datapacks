        "command": "trigger show_stats set 1"
      }
    },
    {
      "label": {
        "text": "Zombies Menu ->",
        "color": "gold"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:zombies"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "pause": false
}
