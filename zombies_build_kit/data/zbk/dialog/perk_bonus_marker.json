{
  "type": "minecraft:multi_action",
  "title": "Perk Bonus Marker",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Marker Type: Perk Bonus\n\nThis marker defines a perk bonus spawn location.\nPerk bonuses grant players a free perk when claimed."
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Delete Perk Machine",
        "color": "red"
      },
      "action": {
        "type": "minecraft:run_command",
        "command": "/function zbk:build_kit/management/perk_machine/delete"
      }
    },
    {
      "label": {
        "text": "← Back to Perks",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:perks"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "pause": false
}
