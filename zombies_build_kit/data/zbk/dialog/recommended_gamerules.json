{
  "type": "minecraft:multi_action",
  "title": "Recommended gamerules",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Set each gamerule to the recommended value for this map.\n\nTo see current value, run /gamerule <name> in chat.\n\nfire_spread_radius_around_player: 0\ncommand_block_output: false\nadvance_time: false\nspawn_mobs: false\nadvance_weather: false\nfall_damage: false\nlocator_bar: false\nlog_admin_commands: false\nsend_command_feedback: false\nmob_griefing: false\nmax_snow_accumulation_height: 0\nspawn_monsters: false"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Set all to recommended",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zbk:gamerules/management/apply_recommended"
      }
    },
    {
      "label": {
        "text": "Revert all to defaults",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "function zbk:gamerules/management/revert_defaults"
      }
    },
    {
      "label": {
        "text": "Set fire_spread_radius_around_player",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule fire_spread_radius_around_player 0"
      }
    },
    {
      "label": {
        "text": "Set command_block_output",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule command_block_output false"
      }
    },
    {
      "label": {
        "text": "Set advance_time",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule advance_time false"
      }
    },
    {
      "label": {
        "text": "Set spawn_mobs",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule spawn_mobs false"
      }
    },
    {
      "label": {
        "text": "Set advance_weather",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule advance_weather false"
      }
    },
    {
      "label": {
        "text": "Set fall_damage",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule fall_damage false"
      }
    },
    {
      "label": {
        "text": "Set locator_bar",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule locator_bar false"
      }
    },
    {
      "label": {
        "text": "Set log_admin_commands",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule log_admin_commands false"
      }
    },
    {
      "label": {
        "text": "Set send_command_feedback",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule send_command_feedback false"
      }
    },
    {
      "label": {
        "text": "Set mob_griefing",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule mob_griefing false"
      }
    },
    {
      "label": {
        "text": "Set max_snow_accumulation_height",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule max_snow_accumulation_height 0"
      }
    },
    {
      "label": {
        "text": "Set spawn_monsters",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "gamerule spawn_monsters false"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:build_kit"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "pause": false
}
