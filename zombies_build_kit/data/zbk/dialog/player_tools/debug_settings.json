{
  "type": "minecraft:multi_action",
  "title": "Debug Settings",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Configure debug message visibility.\n\nLevels control which messages you see:\n  1 = Errors only\n  2 = + Warnings\n  3 = + Events\n  4 = + Info (all messages)"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Toggle Debug Mode",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger toggle_dev_tag set 1"
      }
    },
    {
      "label": {
        "text": "Level 1 (Errors)",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger set_debug_level set 1"
      }
    },
    {
      "label": {
        "text": "Level 2 (+ Warnings)",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger set_debug_level set 2"
      }
    },
    {
      "label": {
        "text": "Level 3 (+ Events)",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger set_debug_level set 3"
      }
    },
    {
      "label": {
        "text": "Level 4 (All)",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger set_debug_level set 4"
      }
    },
    {
      "label": " ",
      "action": {
        "type": "run_command",
        "command": ""
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:player_tools"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
