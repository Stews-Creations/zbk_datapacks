{
  "type": "minecraft:multi_action",
  "title": "Points",
  "external_title": "Points",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Manage player points"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Reset Points",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "trigger reset_points set 1"
      }
    },
    {
      "label": {
        "text": "Give 5000 Points",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_points set 1"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:player_tools"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
