        "text": "Light Level 5 Block",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_light_level_5 set 1"
      }
    },
    {
      "label": {
        "text": "Light Level 6 Block",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_light_level_6 set 1"
      }
