{
  "type": "minecraft:multi_action",
  "title": "Barriers",
  "external_title": "Barriers",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Setup Guide:\n1. Place light source at desired light level\n2. Click button to spawn marker at your location\n3. Marker sets teleport destination\n\nLight Level Blocking:\n- Light level 5: Blocks players only\n- Light level 6: Blocks zombies + players\n- Will teleport to nearest marker"
    }
  ],
  "actions": [
