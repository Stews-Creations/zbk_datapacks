{
  "type": "minecraft:multi_action",
  "title": "Wall Buy - Wonder Weapons",
  "external_title": "Wall Buy - Wonder Weapons",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Select an item to set this wall buy."
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Ray Gun",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zbk:build_kit/management/wall_gun/apply_gun_id {gun_id:7}"
      }
    },
    {
      "label": {
        "text": "Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:wall_gun/weapons"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
