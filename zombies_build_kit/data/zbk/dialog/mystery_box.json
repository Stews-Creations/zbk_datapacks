{
  "type": "minecraft:multi_action",
  "title": "Mystery Box",
  "external_title": "Mystery Box",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Setup Guide:\n1. Place box location markers\n2. Right-click markers with Build Manager to set spawn locations\n3. Spawn locations are available at game start\n4. Other locations unlock after first teddy bear"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Mystery Box - Spawn Egg",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_mystery_box_egg set 1"
      }
    },
    {
      "label": {
        "text": "Reset IDs",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "trigger reset_mystery_box_ids set 1"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zbk:map_elements"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
