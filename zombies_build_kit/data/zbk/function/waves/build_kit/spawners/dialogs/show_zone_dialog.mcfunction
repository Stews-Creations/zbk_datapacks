# === MACRO DIALOG - SHOW SPAWNER ZONE DIALOG ===
# This is a macro function - the $ at the start of the dialog command marks it as a macro
# Variables: spawner_type, spawner_tag, current_zone

$dialog show @s {type:"minecraft:multi_action",title:"Configure $(spawner_type) Spawner",body:[{type:"minecraft:plain_message",contents:[{text:"Current Zone: ",color:"gray"},{text:"$(current_zone)",color:"green",bold:true},{text:"\n\nZone 0 = Always Active\nZones 1-32 = Requires that zone to be unlocked",color:"white"}]}],inputs:[{type:"minecraft:number_range",key:"zone",label:"Select Zone",start:0,end:32,initial:$(current_zone),step:1}],actions:[{label:"Update Zone",action:{type:"dynamic/run_command",template:"function zbk:waves/build_kit/spawners/settings/apply_zone {zone:\u0024(zone),spawner_tag:'$(spawner_tag)',spawner_type:'$(spawner_type)'}"}},{label:"Test Spawn",action:{type:"minecraft:run_command",command:"function zbk:waves/build_kit/spawners/test_spawn/run {spawner_tag:'$(spawner_tag)',spawner_type:'$(spawner_type)'}"}},{label:{text:"Immunity Settings →",color:"gold"},action:{type:"minecraft:run_command",command:"function zbk:waves/build_kit/spawners/dialogs/open_immunity_dialog {spawner_tag:'$(spawner_tag)',spawner_type:'$(spawner_type)'}"}},{label:"Delete Marker",action:{type:"minecraft:run_command",command:"/function zbk:waves/build_kit/spawners/markers/delete_marker {spawner_tag:'$(spawner_tag)',spawner_type:'$(spawner_type)'}"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zbk:build_kit"}}],exit_action:{label:"Close"},columns:2,pause:false}
