# Give knife with player_id in custom_data
# Called with storage containing player_id
$item replace entity @s hotbar.3 with minecraft:netherite_hoe[item_model="zbk:knife",custom_name={"text":"Knife","color":"gray","italic":false},custom_data={player_id:$(player_id),knife:true,bowie_knife:false,knife_damage:$(knife_damage)},enchantment_glint_override=false,unbreakable={},damage_type="zbk:knife",enchantments={"zbk:knife_control":1},attribute_modifiers=[{id:"minecraft:base_attack_damage",type:"minecraft:attack_damage",amount:8,operation:"add_value",slot:"mainhand"},{id:"minecraft:base_attack_speed",type:"minecraft:attack_speed",amount:-2.4,operation:"add_value",slot:"mainhand"}]]
# A running world cannot register newly added damage types or enchantments with /reload.
# Keep melee available until the world is restarted with those registries loaded.
$execute unless items entity @s hotbar.3 minecraft:netherite_hoe[custom_data~{knife:true,bowie_knife:false}] run item replace entity @s hotbar.3 with minecraft:netherite_hoe[item_model="zbk:knife",custom_name={"text":"Knife","color":"gray","italic":false},custom_data={player_id:$(player_id),knife:true,bowie_knife:false,knife_damage:$(knife_damage)},enchantment_glint_override=false,unbreakable={},attribute_modifiers=[{id:"minecraft:base_attack_damage",type:"minecraft:attack_damage",amount:8,operation:"add_value",slot:"mainhand"},{id:"minecraft:base_attack_speed",type:"minecraft:attack_speed",amount:-2.4,operation:"add_value",slot:"mainhand"}]]
