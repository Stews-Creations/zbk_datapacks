# Replace offhand with the Death Machine model while the powerup is active.
# custom_data carries gun:true so swap_weapon/detect still triggers on F-press (used to cancel).
execute as @s[tag=death_machine_active] unless data entity @s Inventory[{Slot:-106b,id:"minecraft:ghast_tear",components:{custom_data:{death_machine:true}}}] run item replace entity @s weapon.offhand with minecraft:ghast_tear[item_model="zbk:guns/special/death_machine",custom_name={"text":"Death Machine","color":"red","italic":false,"bold":true},custom_data={gun:true,death_machine:true},consumable={consume_seconds:1000000},use_effects={can_sprint:true,speed_multiplier:1.0}]
