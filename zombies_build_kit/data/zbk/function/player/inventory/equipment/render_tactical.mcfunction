# Monkey Bomb stack count mirrors special_equipment_ammo.
$execute if score @s special_equipment matches 1 if score @s special_equipment_ammo matches 1 run item replace entity @s hotbar.4 with minecraft:slime_ball[item_model="zbk:special_equipment/monkey_bomb/monkey_bomb",custom_name={"text":"Monkey Bomb","color":"gold","italic":false},custom_data={player_id:$(player_id),special_equipment:true,special_equipment_id:1,monkey_bomb:true}] 1
$execute if score @s special_equipment matches 1 if score @s special_equipment_ammo matches 2 run item replace entity @s hotbar.4 with minecraft:slime_ball[item_model="zbk:special_equipment/monkey_bomb/monkey_bomb",custom_name={"text":"Monkey Bomb","color":"gold","italic":false},custom_data={player_id:$(player_id),special_equipment:true,special_equipment_id:1,monkey_bomb:true}] 2
$execute if score @s special_equipment matches 1 if score @s special_equipment_ammo matches 3.. run item replace entity @s hotbar.4 with minecraft:slime_ball[item_model="zbk:special_equipment/monkey_bomb/monkey_bomb",custom_name={"text":"Monkey Bomb","color":"gold","italic":false},custom_data={player_id:$(player_id),special_equipment:true,special_equipment_id:1,monkey_bomb:true}] 3

# Trip Mine stack count mirrors special_equipment_ammo and uses right-click placement.
$execute if score @s special_equipment matches 2 if score @s special_equipment_ammo matches 1 run item replace entity @s hotbar.4 with minecraft:slime_ball[item_model="zbk:special_equipment/trip_mine/trip_mine",custom_name={"text":"Trip Mine","color":"gold","italic":false},custom_data={player_id:$(player_id),special_equipment:true,special_equipment_id:2,trip_mine:true},consumable={consume_seconds:1000000,animation:"none",has_consume_particles:false},use_effects={can_sprint:true,speed_multiplier:1.0}] 1
$execute if score @s special_equipment matches 2 if score @s special_equipment_ammo matches 2.. run item replace entity @s hotbar.4 with minecraft:slime_ball[item_model="zbk:special_equipment/trip_mine/trip_mine",custom_name={"text":"Trip Mine","color":"gold","italic":false},custom_data={player_id:$(player_id),special_equipment:true,special_equipment_id:2,trip_mine:true},consumable={consume_seconds:1000000,animation:"none",has_consume_particles:false},use_effects={can_sprint:true,speed_multiplier:1.0}] 2
