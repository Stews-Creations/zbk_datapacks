# === MACRO DIALOG - SHOW DOOR CONFIG DIALOG ===
# This is a macro function - the $ at the start of the dialog command marks it as a macro
# Variables: current_price (the price in points), zones (array of zone numbers)

$dialog show @s {type:"minecraft:multi_action",title:"Configure Door",body:[{type:"minecraft:plain_message",contents:[{text:"Current Price: ",color:"gray"},{text:"$(current_price)",color:"green",bold:true},{text:"\nActive Zones: ",color:"gray"},{text:"$(zones)",color:"yellow",bold:true},{text:"\n\nConfigure door price and zones.",color:"white"}]}],inputs:[{type:"minecraft:number_range",key:"price",label:"Door Price",start:0,end:10000,initial:$(current_price),step:50},{type:"minecraft:number_range",key:"zone",label:"Zone Selection",start:0,end:32,initial:0,step:1}],actions:[{label:"Update Price",action:{type:"dynamic/run_command",template:"function zbk:map_elements/door/build_kit/purchasable/settings/apply_price {price:\u0024(price)}"}},{label:"Add Zone",action:{type:"dynamic/run_command",template:"function zbk:map_elements/door/build_kit/purchasable/settings/apply_add_zone {zone:\u0024(zone)}"}},{label:"Remove Zone",action:{type:"dynamic/run_command",template:"function zbk:map_elements/door/build_kit/purchasable/settings/apply_remove_zone {zone:\u0024(zone)}"}},{label:"Delete",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/door/build_kit/purchasable/markers/delete_marker"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zbk:build_kit"}}],exit_action:{label:"Close"}}
