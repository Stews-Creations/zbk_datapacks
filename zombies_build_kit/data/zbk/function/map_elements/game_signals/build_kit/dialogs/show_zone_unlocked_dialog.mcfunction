$dialog show @s {type:"minecraft:multi_action",title:"Signal: Zone Unlocked",body:[{type:"minecraft:plain_message",contents:[{text:"Fires when a specific zone is unlocked via a door.\n\nCurrent Zone: ",color:"white"},{text:"$(current_zone)",color:"aqua",bold:true},{text:"\n\nPulse: Brief redstone pulse (yellow concrete idle)\nToggle: Stays powered once zone unlocks (red concrete idle)",color:"white"}]}],inputs:[{type:"minecraft:number_range",key:"zone",label:"Zone Number",start:0,end:32,initial:$(current_zone),step:1}],actions:[{label:"Set Zone",action:{type:"dynamic/run_command",template:"function zbk:map_elements/game_signals/build_kit/settings/set_zone {zone:\u0024(zone)}"}},{label:"Set Pulse",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/game_signals/build_kit/settings/set_pulse"}},{label:"Set Toggle",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/game_signals/build_kit/settings/set_toggle"}},{label:"Delete",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/game_signals/build_kit/markers/delete_marker"}}],columns:2,pause:false}
