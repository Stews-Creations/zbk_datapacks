# Wall-buy configuration: selected weapon name and price controls.
# Macro variables: gun_name, price, ammo_price, pap_ammo_price. Weapon choice uses named category pages.

$dialog show @s {type:"minecraft:multi_action",title:"Configure Wall Gun",body:[{type:"minecraft:plain_message",contents:[{text:"Weapon: ",color:"gray"},{text:"$(gun_name)",color:"gold",bold:true},{text:"\nPurchase Price: ",color:"gray"},{text:"$(price)",color:"green",bold:true},{text:"\nAmmo Price: ",color:"gray"},{text:"$(ammo_price)",color:"yellow",bold:true},{text:"\nPack-a-Punch Ammo Price: ",color:"gray"},{text:"$(pap_ammo_price)",color:"light_purple",bold:true}]}],inputs:[{type:"minecraft:number_range",key:"price",label:"Purchase Price",start:0,end:10000,initial:$(price),step:50},{type:"minecraft:number_range",key:"ammo_price",label:"Ammo Refill Price",start:0,end:5000,initial:$(ammo_price),step:25},{type:"minecraft:number_range",key:"pap_ammo_price",label:"Pack-a-Punch Ammo Price",start:0,end:10000,initial:$(pap_ammo_price),step:50}],actions:[{label:"Choose Weapon",action:{type:"minecraft:show_dialog",dialog:"zbk:build_kit/map_elements/wall_gun/weapons"}},{label:"Set Price",action:{type:"dynamic/run_command",template:"function zbk:map_elements/wall_gun/build_kit/settings/apply_price {price:\u0024(price)}"}},{label:"Set Ammo Price",action:{type:"dynamic/run_command",template:"function zbk:map_elements/wall_gun/build_kit/settings/apply_ammo_price {ammo_price:\u0024(ammo_price)}"}},{label:"Set PaP Ammo Price",action:{type:"dynamic/run_command",template:"function zbk:map_elements/wall_gun/build_kit/settings/apply_pap_ammo_price {pap_ammo_price:\u0024(pap_ammo_price)}"}},{label:"Delete",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/wall_gun/build_kit/markers/delete_marker"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zbk:build_kit"}}],exit_action:{label:"Close"}}
