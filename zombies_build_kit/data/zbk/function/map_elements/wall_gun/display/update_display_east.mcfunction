# ===================================
# WALL GUN - UPDATE DISPLAY (EAST)
# ===================================
# Purpose: Spawn displays for east-facing wall gun
# Wall is to the east, player faces west to see it
# ===================================

# Text display - shows gun name and prices (rotated 90° CCW to face west)
summon text_display ~0.5 ~0.5 ~ {view_range:0.125f,Tags:["wall_gun_text","wall_gun_ui"],billboard:"fixed",background:0,shadow:true,brightness:{block:15,sky:15},transformation:{left_rotation:[0f,-0.7071068f,0f,0.7071068f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.5f,0.5f,0.5f]}}

# Apply the prebuilt text component with a plain gun-name string.
data modify entity @e[type=text_display,tag=wall_gun_text,tag=!wall_gun_text_set,distance=..2,limit=1,sort=nearest] text set from storage zbk:temp wall_gun_display_text
tag @e[type=text_display,tag=wall_gun_text,distance=..2,limit=1,sort=nearest] add wall_gun_text_set

# Item display - gun model (pointing left from player's view)
# Quaternion for 180° Y: [0f,1f,0f,0f]
execute if score $wall_gun_id wall_gun_price matches 7 run summon item_display ~0.4 ~0.5 ~ {view_range:0.1875f,Tags:["wall_gun_item","wall_gun_ui"],item:{id:"minecraft:stick",count:1,components:{item_model:"zbk:guns/wonder_weapons/ray_gun"}},transformation:{left_rotation:[0f,1f,0f,0f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[1f,1f,1f]}}
execute if score $wall_gun_id wall_gun_price matches 13 run summon item_display ~0.45 ~0.35 ~ {view_range:0.1875f,Tags:["wall_gun_item","wall_gun_ui"],item:{id:"minecraft:snowball",count:1,components:{item_model:"zbk:special_equipment/grenade"}},transformation:{left_rotation:[0f,-0.7071068f,0f,0.7071068f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.35f,0.35f,0.35f]}}
execute if score $wall_gun_id wall_gun_price matches 14 run summon item_display ~0.45 ~0.2 ~ {view_range:0.1875f,Tags:["wall_gun_item","wall_gun_ui"],item:{id:"minecraft:slime_ball",count:1,components:{item_model:"zbk:special_equipment/monkey_bomb/monkey_bomb"}},transformation:{left_rotation:[0f,-0.7071068f,0f,0.7071068f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.25f,0.25f,0.25f]}}
execute if score $wall_gun_id wall_gun_price matches 15 run summon item_display ~0.45 ~0.35 ~ {view_range:0.1875f,Tags:["wall_gun_item","wall_gun_ui"],item:{id:"minecraft:slime_ball",count:1,components:{item_model:"zbk:special_equipment/trip_mine/trip_mine"}},transformation:{left_rotation:[0f,-0.7071068f,0f,0.7071068f],right_rotation:[0f,0f,0f,1f],translation:[0f,0f,0f],scale:[0.275f,0.275f,0.275f]}}

