# Marker price snapshots; the caller supplies the weapon name afterward.
$data modify storage zbk:temp wall_gun_display_text set value [{"text":"","color":"gold","bold":true},{"text":"\nBuy: ","color":"white"},{"text":"$(price)","color":"yellow"},{"text":"\nAmmo: ","color":"gray"},{"text":"$(ammo_price)","color":"green"},{"text":"\nPaP Ammo: ","color":"gray"},{"text":"$(pap_ammo_price)","color":"light_purple"}]
$execute if score $wall_gun_id wall_gun_price matches 14 run data modify storage zbk:temp wall_gun_display_text set value [{"text":"","color":"gold","bold":true},{"text":"\nBuy: ","color":"white"},{"text":"$(price)","color":"yellow"},{"text":"\nAmmo: ","color":"gray"},{"text":"$(ammo_price)","color":"green"}]
$execute if score $wall_gun_id wall_gun_price matches 13 run data modify storage zbk:temp wall_gun_display_text set value [{"text":"","color":"gold","bold":true},{"text":"\nAmmo: ","color":"gray"},{"text":"$(ammo_price)","color":"green"}]
$execute if score $wall_gun_id wall_gun_price matches 15 run data modify storage zbk:temp wall_gun_display_text set value [{"text":"","color":"gold","bold":true},{"text":"\nAmmo: ","color":"gray"},{"text":"$(ammo_price)","color":"green"}]
$execute if score $wall_gun_id wall_gun_price matches 16 run data modify storage zbk:temp wall_gun_display_text set value [{"text":"","color":"gold","bold":true},{"text":"\nBuy: ","color":"white"},{"text":"$(price)","color":"yellow"}]
