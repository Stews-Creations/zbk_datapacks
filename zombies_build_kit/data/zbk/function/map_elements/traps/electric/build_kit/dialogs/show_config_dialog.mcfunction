# === MACRO DIALOG - SHOW TRAP CONFIG DIALOG ===
# This is a macro function - the $ at the start of the dialog command marks it as a macro
# Variables: cost, duration, cooldown

$dialog show @s {type:"minecraft:multi_action",title:"Configure Electric Trap",body:[{type:"minecraft:plain_message",contents:[{text:"Activation Cost: ",color:"gray"},{text:"$(cost)",color:"green",bold:true},{text:"\nActive Duration: ",color:"gray"},{text:"$(duration)",color:"yellow",bold:true},{text:"s\n",color:"yellow"},{text:"Cooldown: ",color:"gray"},{text:"$(cooldown)",color:"red",bold:true},{text:"s",color:"red"}]}],inputs:[{type:"minecraft:number_range",key:"cost",label:"Activation Cost",start:0,end:5000,initial:$(cost),step:50},{type:"minecraft:number_range",key:"duration",label:"Duration (seconds)",start:5,end:60,initial:$(duration),step:5},{type:"minecraft:number_range",key:"cooldown",label:"Cooldown (seconds)",start:10,end:120,initial:$(cooldown),step:5}],actions:[{label:"Set Cost",action:{type:"dynamic/run_command",template:"function zbk:map_elements/traps/electric/build_kit/settings/apply_cost {cost:$(d)(cost)}"}},{label:"Set Duration",action:{type:"dynamic/run_command",template:"function zbk:map_elements/traps/electric/build_kit/settings/apply_duration {duration:$(d)(duration)}"}},{label:"Set Cooldown",action:{type:"dynamic/run_command",template:"function zbk:map_elements/traps/electric/build_kit/settings/apply_cooldown {cooldown:$(d)(cooldown)}"}},{label:"Delete Trap",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/traps/electric/build_kit/markers/delete_trap"}}],exit_action:{label:"Close"}}
