# === MACRO DIALOG - SHOW CUSTOM DOOR CONFIG DIALOG ===
# Variables: current_id, marker_type, current_anim, current_speed, current_float_label, current_power_label

$dialog show @s {type:"minecraft:multi_action",title:"Configure Custom Door",body:[{type:"minecraft:plain_message",contents:[{text:"Marker: ",color:"gray"},{text:"$(marker_type)",color:"green",bold:true},{text:"\nLink ID: ",color:"gray"},{text:"$(current_id)",color:"yellow",bold:true},{text:" ",color:"white"},{text:"(0 = unlinked)",color:"dark_aqua",italic:true},{text:"\n\nAssign the same ID to both Corner 1 and Corner 2 to link them.",color:"white"},{text:"\nAnimation: ",color:"gray"},{text:"$(current_anim)",color:"aqua",bold:true},{text:" ",color:"white"},{text:"(1=Up, 2=Down, 3=Disappear)",color:"dark_aqua",italic:true},{text:"\nSpeed: ",color:"gray"},{text:"$(current_speed)",color:"aqua",bold:true},{text:" ",color:"white"},{text:"ticks/layer (lower = faster)",color:"dark_aqua",italic:true},{text:"\nFloating: ",color:"gray"},{text:"$(current_float_label)",color:"aqua",bold:true},{text:"\nPower Door: ",color:"gray"},{text:"$(current_power_label)",color:"aqua",bold:true},{text:"\nIDs in use: ",color:"gray"},{text:"$(used_ids)",color:"yellow"},{text:"\nDoor zones must be under 100 blocks on each axis.",color:"red",italic:true},{text:"\nRemove Blocks only works on saved zones.",color:"dark_aqua",italic:true}]}],inputs:[{type:"minecraft:number_range",key:"link_id",label:"Link ID (1-99)",start:1,end:99,initial:1,step:1},{type:"minecraft:number_range",key:"anim_style",label:"Animation Style",start:1,end:3,initial:$(current_anim),step:1},{type:"minecraft:number_range",key:"anim_speed",label:"Animation Speed (ticks/layer)",start:1,end:10,initial:$(current_speed),step:1}],actions:[{label:"Assign Link ID",action:{type:"dynamic/run_command",template:"function zbk:build_kit/management/custom_door/settings/apply_link_id {id:\u0024(link_id)}"}},{label:"Set Animation",action:{type:"dynamic/run_command",template:"function zbk:build_kit/management/custom_door/settings/apply_animation {style:\u0024(anim_style),speed:\u0024(anim_speed)}"}},{label:"Save Zone",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/custom_door/zone/save"}},{label:"Toggle Float (Block Displays)",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/custom_door/settings/toggle_float"}},{label:"Toggle Power Door",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/custom_door/settings/toggle_power"}},{label:"TP to Storage",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/custom_door/teleport/to_storage"}},{label:"Delete Marker",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/custom_door/delete_marker"}},{label:"Delete Door (Keep Blocks)",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/custom_door/delete_door"}},{label:"Delete Door (Remove Blocks)",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/custom_door/delete_door_all"}},{label:"Show Used IDs",action:{type:"minecraft:run_command",command:"function zbk:build_kit/management/custom_door/show_used_ids"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zbk:build_kit"}}],exit_action:{label:"Close"}}
