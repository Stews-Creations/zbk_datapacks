# === MACRO DIALOG - SHOW TELEPORTER AUTO-RETURN MARKER DIALOG ===
# Variables: current_id, used_ids

$dialog show @s {type:"minecraft:multi_action",title:"Auto-Return Marker",body:[{type:"minecraft:plain_message",contents:[{text:"Current Link ID: ",color:"gray"},{text:"$(current_id)",color:"yellow",bold:true},{text:" ",color:"white"},{text:"(0 = unlinked)",color:"dark_gray",italic:true},{text:"\nIDs in use: ",color:"gray"},{text:"$(used_ids)",color:"yellow"},{text:"\n\nThis marker is only the auto-return destination.",color:"white"}]}],inputs:[{type:"minecraft:number_range",key:"link_id",label:"Link ID (1-99)",start:1,end:99,initial:1,step:1}],actions:[{label:"Assign Link ID",action:{type:"dynamic/run_command",template:"function zbk:build_kit/management/teleporter/apply_link_id {id:\u0024(link_id)}"}},{label:"Clear Link",action:{type:"minecraft:run_command",command:"function zbk:build_kit/management/teleporter/clear_link"}},{label:"Delete Marker",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/teleporter/delete_marker"}},{label:"Show Used IDs",action:{type:"minecraft:run_command",command:"function zbk:build_kit/management/teleporter/show_used_ids"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zbk:build_kit"}}],exit_action:{label:"Close"}}
