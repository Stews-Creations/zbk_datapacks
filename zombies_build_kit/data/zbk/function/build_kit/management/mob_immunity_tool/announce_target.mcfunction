# Announce tool results from the targeted mob context.

execute if score @p[tag=mob_immunity_tool_user,distance=..8,sort=nearest,limit=1] mob_immunity_tool_mode matches 0 run tellraw @p[tag=mob_immunity_tool_user,distance=..8,sort=nearest,limit=1] [{"text":"[Mob Immunity] ","color":"gold"},{"selector":"@s","color":"yellow"},{"text":" is now immune to guns.","color":"green"}]
