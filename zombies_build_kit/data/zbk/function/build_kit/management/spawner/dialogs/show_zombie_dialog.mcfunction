# === MACRO DIALOG - SHOW ZOMBIE SPAWNER DIALOG ===
# Variables: current_zone, current_mode, mode_label

$dialog show @s {type:"minecraft:multi_action",title:"Configure Zombie Spawner",body:[{type:"minecraft:plain_message",contents:[{text:"Current Zone: ",color:"gray"},{text:"$(current_zone)",color:"green",bold:true},{text:"\nMode: ",color:"gray"},{text:"$(mode_label)",color:"yellow",bold:true},{text:"\n\nModes:\n0 Standard\n1 Hole East, 2 Hole South, 3 Hole West, 4 Hole North\n5 Wall East, 6 Wall South, 7 Wall West, 8 Wall North\n\nPlace directional markers behind the opening. Look from the marker toward the hole/wall and choose that direction. Use Hole for zombies that crawl out of a hole. Use Wall for zombies that climb a wall.",color:"white"},{text:"\n\nZone 0 = Always Active\nZones 1-32 = Requires that zone to be unlocked",color:"white"}]}],inputs:[{type:"minecraft:number_range",key:"zone",label:"Select Zone",start:0,end:32,initial:$(current_zone),step:1},{type:"minecraft:number_range",key:"mode",label:"Mode (0-8, see list)",start:0,end:8,initial:$(current_mode),step:1}],actions:[{label:"Update Zone/Mode",action:{type:"dynamic/run_command",template:"function zbk:build_kit/management/spawner/apply_zombie_config {zone:\u0024(zone),mode:\u0024(mode)}"}},{label:"Test Spawn",action:{type:"minecraft:run_command",command:"function zbk:build_kit/management/spawner/test_spawn/run {spawner_tag:'zombie_spawner',spawner_type:'Zombie'}"}},{label:{text:"Immunity Settings →",color:"gold"},action:{type:"minecraft:run_command",command:"function zbk:build_kit/management/spawner/dialogs/open_immunity_dialog {spawner_tag:'zombie_spawner',spawner_type:'Zombie'}"}},{label:"Delete Marker",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/spawner/delete_marker {spawner_tag:'zombie_spawner',spawner_type:'Zombie'}"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zbk:build_kit"}}],exit_action:{label:"Close"},columns:2,pause:false}
