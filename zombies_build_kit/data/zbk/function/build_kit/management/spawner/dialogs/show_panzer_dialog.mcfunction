# Macro dialog for global Panzer spawner settings.

$dialog show @s {type:"minecraft:multi_action",title:"Panzer Spawners",body:[{type:"minecraft:plain_message",contents:[{text:"First Round: ",color:"gray"},{text:"$(first_round)",color:"yellow",bold:true},{text:"\nRepeat Every: ",color:"gray"},{text:"$(repeat_every)",color:"yellow",bold:true},{text:" rounds",color:"yellow"},{text:"\n\nThese settings control Panzer special spawns globally. Individual Panzer spawn markers still use Build Stick zone settings.",color:"white"}]}],inputs:[{type:"minecraft:number_range",key:"first_round",label:"First Round",start:1,end:100,initial:$(first_round),step:1},{type:"minecraft:number_range",key:"repeat_every",label:"Repeat Every (Rounds)",start:1,end:50,initial:$(repeat_every),step:1}],actions:[{label:"Panzer Spawn Marker",action:{type:"minecraft:run_command",command:"trigger give_panzer_marker set 1"}},{label:"Apply Timing",action:{type:"dynamic/run_command",template:"function zbk:build_kit/management/spawner/apply_panzer_timing {first_round:\u0024(first_round),repeat_every:\u0024(repeat_every)}"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zbk:zombie_control"}}],exit_action:{label:"Close"},columns:2,pause:false}
