$dialog show @s {type:"minecraft:multi_action",title:"End Game - End Position",body:[{type:"minecraft:plain_message",contents:"Camera END position for the end game cutscene.\n\nThe camera will pan here from the start position. Game Over title shows at 7 blocks, combat record at 1 block.\n\nCurrent Speed: $(speed) blocks/sec"}],inputs:[{type:"minecraft:number_range",key:"cutscene_speed",label:"Speed (blocks/sec)",start:1,end:20,initial:$(speed),step:1}],actions:[{label:"Set Speed",action:{type:"dynamic/run_command",template:"function zbk:build_kit/management/cutscenes/dialogs/apply_end_pan {speed:\u0024(cutscene_speed)}"}},{label:"Delete",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/cutscenes/end_game/delete_end"}},{label:"Close",action:{type:"minecraft:run_command",command:""}}],exit_action:{label:"Close"},pause:false}
