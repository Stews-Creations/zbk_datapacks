$dialog show @s {type:"minecraft:multi_action",title:"Start Game - End Position",body:[{type:"minecraft:plain_message",contents:"Camera END position for the start game cutscene.\n\nThe camera will pan here from the start position, then the game begins.\n\nCurrent Speed: $(speed) blocks/sec"}],inputs:[{type:"minecraft:number_range",key:"cutscene_speed",label:"Speed (blocks/sec)",start:1,end:20,initial:$(speed),step:1}],actions:[{label:"Set Speed",action:{type:"dynamic/run_command",template:"function zbk:build_kit/management/cutscenes/dialogs/apply_start_pan {speed:\u0024(cutscene_speed)}"}},{label:"Delete",action:{type:"minecraft:run_command",command:"/function zbk:map_elements/cutscenes/start_game/delete_end"}},{label:"Close",action:{type:"minecraft:run_command",command:""}}],exit_action:{label:"Close"},pause:false}
