dialog show @s {type:"minecraft:multi_action",title:"Signal: Power On",body:[{type:"minecraft:plain_message",contents:"Fires when map power is activated.\n\nPulse: Brief redstone pulse (yellow concrete idle)\nToggle: Stays powered while power is on (red concrete idle)\n\nIf the map does not require power, pulse fires on game start and toggle stays active for the entire game."}],actions:[{label:"Set Pulse",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/game_signal/set_pulse"}},{label:"Set Toggle",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/game_signal/set_toggle"}},{label:"Delete",action:{type:"minecraft:run_command",command:"/function zbk:build_kit/management/game_signal/delete_marker"}}],columns:2,pause:false}
