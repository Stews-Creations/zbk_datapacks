{
  "type": "minecraft:multi_action",
  "title": "Game Signals",
  "external_title": "Game Signals",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Game Signals let your map react to game events using redstone.\n\nPlace a signal marker where you want it. The block will swap between redstone block (active) and concrete (idle) based on game events.\n\nPulse signals act like a stone button press.\nToggle signals act like a lever.\nGame End, Cutscene Start, and Cutscene End only support pulse mode.\n\nUse the Build Manager to configure or delete placed signals."
    }
  ],
