{
  "type": "minecraft:multi_action",
  "title": "Pack a Punch",
  "external_title": "Pack a Punch",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Pack your active weapon or assign an elemental effect (free)"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Pack Weapon",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:build_kit/management/pack_a_punch/pack"
      }
    },
    {
      "label": {
        "text": "Blast Furnace 🔥",
        "color": "gold"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:build_kit/management/pack_a_punch/element {element:1}"
      }
    },
    {
      "label": {
        "text": "Dead Wire ⚡",
        "color": "yellow"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:build_kit/management/pack_a_punch/element {element:2}"
      }
    },
    {
      "label": {
        "text": "Fireworks ★",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:build_kit/management/pack_a_punch/element {element:3}"
      }
    },
    {
      "label": {
        "text": "Thunder Wall ⛈",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:build_kit/management/pack_a_punch/element {element:4}"
      }
    },
    {
      "label": {
        "text": "Turned ☠",
        "color": "green"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:build_kit/management/pack_a_punch/element {element:5}"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zombies:player_tools"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
