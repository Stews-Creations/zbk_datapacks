{
  "type": "minecraft:multi_action",
  "title": "Crafting Bench",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Delete this bench and its linked hitboxes, item displays, and text. Active building stops. A shield built here becomes available to rebuild elsewhere; shields already claimed are kept."
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Delete Crafting Bench",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:build_kit/management/buildables/delete_bench"
      }
    }
  ],
  "exit_action": {
    "label": "Close"
  },
  "pause": false
}
