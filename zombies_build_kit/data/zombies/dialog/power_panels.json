{
  "type": "minecraft:multi_action",
  "title": "Power Panels",
  "external_title": "Power Panels",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Control the power system for your map"
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Turn Power ON",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger turn_power_on set 1"
      }
    },
    {
      "label": {
        "text": "Turn Power OFF",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger turn_power_off set 1"
      }
    },
    {
      "label": {
        "text": "Power Switch Egg",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger give_power_egg set 1"
      }
    },
    {
      "label": {
        "text": "Toggle Power Required",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "trigger toggle_power_required set 1"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zombies:map_elements"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
