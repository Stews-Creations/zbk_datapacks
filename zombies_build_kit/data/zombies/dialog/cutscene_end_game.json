{
  "type": "minecraft:multi_action",
  "title": "End Game Cutscene",
  "external_title": "End Game Cutscene",
  "body": [
    {
      "type": "minecraft:plain_message",
      "contents": "Choose a cutscene type:\n\nCamera Pan: Two markers - camera smoothly pans from start to end\nTimed: Single marker - static camera for a set duration\n\nOnly one type can be active at a time."
    }
  ],
  "actions": [
    {
      "label": {
        "text": "Place Pan Start",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:map_elements/cutscenes/end_game/spawn_start"
      }
    },
    {
      "label": {
        "text": "Place Pan End",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:map_elements/cutscenes/end_game/spawn_end"
      }
    },
    {
      "label": {
        "text": "Place Timed",
        "color": "aqua"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:map_elements/cutscenes/end_game/spawn_timed"
      }
    },
    {
      "label": {
        "text": "Delete Pan Start",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:map_elements/cutscenes/end_game/delete_start"
      }
    },
    {
      "label": {
        "text": "Delete Pan End",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:map_elements/cutscenes/end_game/delete_end"
      }
    },
    {
      "label": {
        "text": "Delete Timed",
        "color": "red"
      },
      "action": {
        "type": "run_command",
        "command": "function zombies:map_elements/cutscenes/end_game/delete_timed"
      }
    },
    {
      "label": {
        "text": "← Back",
        "color": "white"
      },
      "action": {
        "type": "show_dialog",
        "dialog": "zombies:cutscenes"
      }
    }
  ],
  "exit_action": {
    "label": {
      "text": "Close",
      "color": "white"
    }
  },
  "columns": 2,
  "pause": false
}
