# Purpose: Summon the invisible marker (build-stick target), display entities, and interaction
# Called as @s = the bat, at @s = its position

# Summon the invisible marker for build stick targeting
summon marker ~ ~ ~ {Tags:["build_manager_target","radio_marker"]}

# Summon display entities (block_display with item_display passengers)
