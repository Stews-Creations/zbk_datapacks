# === CUSTOM DOOR - GIVE PLACEMENT FRAMES ===
# Gives all custom door glow item frames to the player

# Custom Door Corner 1
give @s minecraft:glow_item_frame[custom_name=[{"text":"Custom Door Corner 1","italic":false,"color":"green"}],custom_data={door_frame:1b,placement_marker:1b,placement_type:"custom_door",placement_variant:"corner_1"}] 1

# Custom Door Corner 2
give @s minecraft:glow_item_frame[custom_name=[{"text":"Custom Door Corner 2","italic":false,"color":"aqua"}],custom_data={door_frame:1b,placement_marker:1b,placement_type:"custom_door",placement_variant:"corner_2"}] 1

# Custom Door Sign - Endermite (smallest mob for precise placement)
give @s minecraft:endermite_spawn_egg[custom_name=[{"text":"Custom Door Sign","italic":false,"color":"gold"}]] 1
