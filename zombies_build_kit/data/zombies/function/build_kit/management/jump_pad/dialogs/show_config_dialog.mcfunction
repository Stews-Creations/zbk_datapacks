# === MACRO DIALOG - SHOW JUMP PAD CONFIG DIALOG ===
# This is a macro function - the $ at the start of the dialog command marks it as a macro
# Variables: current_price, current_id, current_cooldown, require_unlock_text

$dialog show @s {type:"minecraft:multi_action",title:"Configure Jump Pad",body:[{type:"minecraft:plain_message",contents:[{text:"Current Price: ",color:"gray"},{text:"$(current_price)",color:"green",bold:true},{text:"\nCurrent Link ID: ",color:"gray"},{text:"$(current_id)",color:"yellow",bold:true},{text:" ",color:"white"},{text:"(0 = unlinked)",color:"dark_gray",italic:true},{text:"\nCooldown: ",color:"gray"},{text:"$(current_cooldown)",color:"red",bold:true},{text:"s",color:"red"},{text:"\nRequire Unlock: ",color:"gray"},{text:"$(require_unlock_text)",color:"yellow",bold:true},{text:"\nIDs in use: ",color:"gray"},{text:"$(used_ids)",color:"yellow"},{text:"\n\nTo link markers:\n1. Select an ID (1-99)\n2. Assign to Start marker\n3. Assign to Peak marker\n4. Assign to End marker\n\nAll 3 markers must share the same ID!",color:"white"}]}],inputs:[{type:"minecraft:number_range",key:"price",label:"Jump Pad Price",start:0,end:10000,initial:$(current_price),step:50},{type:"minecraft:number_range",key:"link_id",label:"Link ID (1-99)",start:1,end:99,initial:1,step:1},{type:"minecraft:number_range",key:"cooldown",label:"Cooldown (seconds)",start:1,end:300,initial:$(current_cooldown),step:1}],actions:[{label:"Update Price",action:{type:"dynamic/run_command",template:"function zombies:build_kit/management/jump_pad/apply_price {price:\u0024(price)}"}},{label:"Assign Link ID",action:{type:"dynamic/run_command",template:"function zombies:build_kit/management/jump_pad/apply_link_id {id:\u0024(link_id)}"}},{label:"Set Cooldown",action:{type:"dynamic/run_command",template:"function zombies:build_kit/management/jump_pad/apply_cooldown {cooldown:\u0024(cooldown)}"}},{label:"Toggle Require Unlock",action:{type:"minecraft:run_command",command:"function zombies:build_kit/management/jump_pad/toggle_require_unlock"}},{label:"Clear Link",action:{type:"minecraft:run_command",command:"function zombies:build_kit/management/jump_pad/clear_link"}},{label:"Toggle Visibility",action:{type:"minecraft:run_command",command:"function zombies:build_kit/management/jump_pad/toggle_visibility"}},{label:"Delete",action:{type:"minecraft:run_command",command:"/function zombies:build_kit/management/jump_pad/delete_marker"}},{label:"Show Used IDs",action:{type:"minecraft:run_command",command:"function zombies:build_kit/management/jump_pad/show_used_ids"}},{label:"Back",action:{type:"minecraft:show_dialog",dialog:"zombies:build_kit"}}],exit_action:{label:"Close"}}
